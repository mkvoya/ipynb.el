;;; ipynb.el --- A cell-oriented Jupyter notebook editor -*- lexical-binding: t; -*-

;; Author: ipynb.el contributors
;; Version: 0.2.0
;; Package-Requires: ((emacs "28.1"))
;; Keywords: languages, tools, multimedia
;; SPDX-License-Identifier: GPL-3.0-or-later

;;; Commentary:
;; Visit .ipynb files to navigate notebooks.  RET edits a cell in its own
;; language mode; C-c C-c commits it.  C-RET executes a cell via Jupyter.
;; Editing and saving require only Emacs.  Execution needs Python 3.9+ and
;; jupyter_client, plus an installed Jupyter kernel.  See README.org.

;;; Code:
(require 'cl-lib)
(require 'json)
(require 'ansi-color)
(require 'subr-x)
(declare-function ipynb-preview--string "ipynb-preview" (cell &optional source width))

(defgroup ipynb nil "Cell-oriented Jupyter notebooks." :group 'tools)
(defcustom ipynb-python-command nil
  "Python executable for the bridge, or nil to discover a virtual environment."
  :type '(choice (const nil) string))
(defcustom ipynb-default-kernel "python3" "Kernel for new notebooks." :type 'string)
(defcustom ipynb-language-modes
  '(("python" . python-mode) ("julia" . julia-mode) ("R" . ess-r-mode)
    ("r" . ess-r-mode) ("javascript" . js-mode) ("typescript" . typescript-mode)
    ("bash" . sh-mode) ("sh" . sh-mode) ("ruby" . ruby-mode))
  "Major modes used in code cell editors." :type '(alist :key-type string :value-type function))
(defcustom ipynb-markdown-preview t
  "Render Markdown cells inline when markdown-it-py is available."
  :type 'boolean :group 'ipynb)
(make-variable-buffer-local 'ipynb-markdown-preview)
(defcustom ipynb-display-images t "Display supported images inline." :type 'boolean)
(defcustom ipynb-auto-inspect nil "Show kernel inspection in Eldoc while editing cells." :type 'boolean)
(defconst ipynb--directory
  (file-name-directory (or load-file-name buffer-file-name default-directory)))
(defface ipynb-cell-header '((t :inherit font-lock-keyword-face :weight bold))
  "Cell separator face.")
(defface ipynb-output '((t :inherit shadow)) "Text output face.")

(defvar-local ipynb--notebook nil)
(defvar-local ipynb--cells nil)
(defvar-local ipynb--history nil)
(defvar-local ipynb--future nil)
(defvar-local ipynb--folded nil)
(defvar-local ipynb--process nil)
(defvar-local ipynb--status "disconnected")
(defvar-local ipynb--requests nil)
(defvar-local ipynb--displays nil)
(defvar-local ipynb--pending-clear nil)
(defvar-local ipynb--editors nil)
(defvar-local ipynb--parent nil)
(defvar-local ipynb--cell nil)
(defvar-local ipynb--original-source nil)
(defvar ipynb--clipboard nil)
(defvar ipynb-after-change-hook nil "Hook run in a notebook after its model changes.")
(defcustom ipynb-separator-width nil
  "Cell separator width in columns, or nil to fit the notebook window."
  :type '(choice (const nil) integer) :group 'ipynb)
(defun ipynb--separator (label)
  (let ((width (or ipynb-separator-width
                   (window-body-width (or (get-buffer-window (current-buffer)) (selected-window))))))
    (concat label " " (make-string (max 2 (- width (string-width label) 1)) ?─) "\n")))


(defun ipynb--object (&rest pairs)
  "Make a JSON object from alternating key/value PAIRS."
  (let ((object (make-hash-table :test #'equal)))
    (while pairs (puthash (pop pairs) (pop pairs) object)) object))
(defun ipynb--parse (text)
  (json-parse-string text :object-type 'hash-table :array-type 'array
                     :null-object :null :false-object :false))
(defun ipynb--json (object)
  (let ((text (json-serialize object :null-object :null :false-object :false)))
    (if (multibyte-string-p text) text (decode-coding-string text 'utf-8))))
(defun ipynb--copy (object) (ipynb--parse (ipynb--json object)))
(defun ipynb--text (value)
  (cond ((stringp value) value) ((vectorp value) (mapconcat #'identity value ""))
        (t "")))
(defun ipynb--id () (substring (secure-hash 'sha256 (format "%s%s%s" (float-time) (random) (current-buffer))) 0 16))
(defun ipynb--new-cell (&optional type)
  (let* ((type (or type "code"))
         (cell (ipynb--object "cell_type" type "id" (ipynb--id)
                              "metadata" (ipynb--object) "source" "")))
    (when (equal type "code")
      (puthash "execution_count" :null cell) (puthash "outputs" [] cell)) cell))
(defun ipynb--current-index ()
  (or (get-text-property (point) 'ipynb-index)
      (and (> (point) (point-min)) (get-text-property (1- (point)) 'ipynb-index)) 0))
(defun ipynb--current-cell ()
  (or (nth (ipynb--current-index) ipynb--cells) (user-error "Notebook has no cells; press b to add one")))
(defun ipynb--language ()
  (let ((metadata (gethash "metadata" ipynb--notebook)))
    (or (gethash "name" (gethash "language_info" metadata (ipynb--object)))
        (gethash "language" (gethash "kernelspec" metadata (ipynb--object))) "python")))
(defun ipynb--kernel ()
  (gethash "name" (gethash "kernelspec" (gethash "metadata" ipynb--notebook)
                           (ipynb--object)) ipynb-default-kernel))

(defun ipynb--snapshot ()
  (push (ipynb--copy (vconcat ipynb--cells)) ipynb--history)
  (setq ipynb--future nil))
(defun ipynb--changed (&optional index)
  (set-buffer-modified-p t) (ipynb--render index)
  (run-hooks 'ipynb-after-change-hook))
(defun ipynb--assert-no-editors ()
  (setq ipynb--editors (cl-remove-if-not #'buffer-live-p ipynb--editors))
  (when ipynb--editors (user-error "Finish cell editing with C-c C-c first")))

(defun ipynb--insert-output (output)
  (let ((type (gethash "output_type" output)))
    (cond
     ((equal type "stream") (insert (ansi-color-apply (ipynb--text (gethash "text" output)))))
     ((equal type "error")
      (insert (ansi-color-apply
               (mapconcat #'identity (append (gethash "traceback" output) nil) "\n")) "\n"))
     (t
      (let* ((data (gethash "data" output))
             (image-datum
              (and ipynb-display-images (display-images-p)
                   (cl-loop for (mime . kind) in '(("image/png" . png) ("image/jpeg" . jpeg) ("image/svg+xml" . svg))
                            for value = (and data (gethash mime data))
                            when (and value (image-type-available-p kind))
                            return (cons kind (if (eq kind 'svg) (ipynb--text value)
                                                (base64-decode-string (ipynb--text value))))))))
        (if image-datum
            (condition-case nil
                (insert-image (create-image (cdr image-datum) (car image-datum) t
                                            :max-width 900 :max-height 600))
              (error (insert "[Image could not be displayed]")))
          (insert (ansi-color-apply
                   (if data (ipynb--text (gethash "text/plain" data "[Rich output; preserved in notebook]")) ""))))))))
  (unless (bolp) (insert "\n")))

(defun ipynb--insert-source (cell)
  "Insert CELL source with language-mode syntax highlighting."
  (let* ((type (gethash "cell_type" cell))
         (mode (if (equal type "code") (cdr (assoc (ipynb--language) ipynb-language-modes))
                 (if (equal type "markdown") 'markdown-mode 'text-mode)))
         (source (ipynb--text (gethash "source" cell)))
         (preview (when (and ipynb-markdown-preview (equal type "markdown"))
                    (require 'ipynb-preview)
                    (ipynb-preview--string cell))))
    (insert
     (or preview (with-temp-buffer
       (insert source)
       (when (fboundp mode)
         (let ((inhibit-message t))
           (condition-case nil
               (progn (delay-mode-hooks (funcall mode)) (font-lock-ensure))
             (error nil))))
       (buffer-string))))))

(defun ipynb--window-resized (_window)
  (when (and (derived-mode-p 'ipynb-mode) ipynb--notebook)
    (ipynb--render)))

(defun ipynb--render (&optional index)
  (let* ((inhibit-read-only t) (modified (buffer-modified-p))
         (displacement (if index 0
                         (- (point) (or (text-property-any (point-min) (point-max)
                                                          'ipynb-index (ipynb--current-index))
                                        (point-min)))))
         (index (or index (ipynb--current-index))) (offset 0))
    (erase-buffer)
    (if (null ipynb--cells)
        (insert "Empty notebook — press b to add a cell.\n")
      (cl-loop for cell in ipynb--cells for i from 0 do
               (let ((start (point)) (id (gethash "id" cell)))
                 (when (= i index) (setq offset (1- start)))
                 (insert (propertize
                          (ipynb--separator (format "── %d · %s [%s]%s" (1+ i) (gethash "cell_type" cell)
                                  (let ((n (gethash "execution_count" cell)))
                                    (if (or (null n) (eq n :null)) " " n))
                                  (if (member id ipynb--folded) " (folded)" "")))
                          'face 'ipynb-cell-header))
                 (unless (member id ipynb--folded)
                   (ipynb--insert-source cell)
                   (unless (bolp) (insert "\n"))
                   (let ((out-start (point)))
                     (mapc #'ipynb--insert-output (gethash "outputs" cell))
                     (add-face-text-property out-start (point) 'ipynb-output t)))
                 (insert "\n")
                 (add-text-properties start (point) (list 'ipynb-index i)))))
    (goto-char (min (point-max) (1+ offset)))
    (let ((end (next-single-property-change (point) 'ipynb-index nil (point-max))))
      (goto-char (min (max (point) (1- end)) (+ (point) displacement))))
    (set-buffer-modified-p modified)))

(defun ipynb-next-cell () "Move to the next cell." (interactive)
  (ipynb--goto (min (1- (length ipynb--cells)) (1+ (ipynb--current-index)))))
(defun ipynb-previous-cell () "Move to the previous cell." (interactive)
  (ipynb--goto (max 0 (1- (ipynb--current-index)))))
(defun ipynb--goto (index)
  (goto-char (point-min))
  (let ((pos (text-property-any (point-min) (point-max) 'ipynb-index index)))
    (when pos (goto-char pos))))
(defun ipynb-jump-to-cell () "Choose a cell by its first line." (interactive)
  (let* ((choices (cl-loop for cell in ipynb--cells for i from 0
                           collect (cons (format "%d: %s" (1+ i)
                                                 (car (split-string (ipynb--text (gethash "source" cell)) "\n"))) i)))
         (choice (completing-read "Cell: " choices nil t)))
    (ipynb--goto (cdr (assoc choice choices)))))
(defun ipynb-insert-cell (&optional above)
  "Insert a code cell below point, or ABOVE with prefix argument." (interactive "P")
  (let ((index (if ipynb--cells (+ (ipynb--current-index) (if above 0 1)) 0)))
    (ipynb--snapshot)
    (setq ipynb--cells (append (cl-subseq ipynb--cells 0 index)
                               (list (ipynb--new-cell)) (nthcdr index ipynb--cells)))
    (ipynb--changed index)))
(defun ipynb-insert-cell-above () "Insert a code cell above point." (interactive) (ipynb-insert-cell t))
(defun ipynb-copy-cell () "Copy the current cell." (interactive)
  (setq ipynb--clipboard (ipynb--copy (ipynb--current-cell))))
(defun ipynb-delete-cell () "Delete the current cell." (interactive)
  (ipynb--assert-no-editors)
  (let ((cell (ipynb--current-cell)) (index (ipynb--current-index)))
    (ipynb--snapshot) (setq ipynb--cells (delq cell ipynb--cells))
    (ipynb--changed (max 0 (min index (1- (length ipynb--cells)))))))
(defun ipynb-cut-cell () "Copy and delete the current cell." (interactive)
  (ipynb--assert-no-editors) (ipynb-copy-cell) (ipynb-delete-cell))
(defun ipynb-paste-cell (&optional above) "Paste a cell below, or ABOVE with prefix." (interactive "P")
  (unless ipynb--clipboard (user-error "No copied cell"))
  (let* ((index (if ipynb--cells (+ (ipynb--current-index) (if above 0 1)) 0))
         (cell (ipynb--copy ipynb--clipboard)))
    (puthash "id" (ipynb--id) cell) (ipynb--snapshot)
    (setq ipynb--cells (append (cl-subseq ipynb--cells 0 index) (list cell) (nthcdr index ipynb--cells)))
    (ipynb--changed index)))
(defun ipynb-move-cell (delta) "Move current cell by DELTA positions." (interactive "p")
  (let* ((index (ipynb--current-index)) (target (+ index delta)) (cell (ipynb--current-cell)))
    (when (and (>= target 0) (< target (length ipynb--cells)))
      (ipynb--snapshot) (setq ipynb--cells (delq cell ipynb--cells))
      (setq ipynb--cells (append (cl-subseq ipynb--cells 0 target) (list cell) (nthcdr target ipynb--cells)))
      (ipynb--changed target))))
(defun ipynb-move-cell-up () "Move current cell up." (interactive) (ipynb-move-cell -1))
(defun ipynb-move-cell-down () "Move current cell down." (interactive) (ipynb-move-cell 1))
(defun ipynb-set-cell-type (type)
  "Convert the current cell to TYPE." (interactive (list (completing-read "Type: " '("code" "markdown" "raw") nil t)))
  (ipynb--assert-no-editors)
  (unless (member type '("code" "markdown" "raw")) (user-error "Invalid cell type"))
  (let ((cell (ipynb--current-cell)))
    (unless (equal type (gethash "cell_type" cell))
      (ipynb--snapshot) (puthash "cell_type" type cell)
      (remhash "attachments" cell)
      (if (equal type "code")
          (progn (puthash "outputs" [] cell) (puthash "execution_count" :null cell))
        (remhash "outputs" cell) (remhash "execution_count" cell))
      (ipynb--changed))))
(defun ipynb-toggle-fold () "Toggle the current cell's contents and outputs." (interactive)
  (let ((id (gethash "id" (ipynb--current-cell))))
    (setq ipynb--folded (if (member id ipynb--folded) (delete id ipynb--folded) (cons id ipynb--folded))))
  (ipynb--render))
(defun ipynb-undo () "Undo the last notebook edit (cell editors have ordinary undo)." (interactive)
  (ipynb--assert-no-editors)
  (unless ipynb--history (user-error "No notebook undo information"))
  (push (ipynb--copy (vconcat ipynb--cells)) ipynb--future)
  (setq ipynb--cells (append (pop ipynb--history) nil)) (ipynb--changed))
(defun ipynb-redo () "Redo a notebook edit." (interactive)
  (ipynb--assert-no-editors)
  (unless ipynb--future (user-error "No notebook redo information"))
  (push (ipynb--copy (vconcat ipynb--cells)) ipynb--history)
  (setq ipynb--cells (append (pop ipynb--future) nil)) (ipynb--changed))

(defvar ipynb-cell-edit-mode-map
  (let ((map (make-sparse-keymap)))
    (define-key map (kbd "C-c C-c") #'ipynb-cell-commit)
    (define-key map (kbd "C-c C-k") #'ipynb-cell-abort)
    (define-key map (kbd "C-c C-s") #'ipynb-cell-save)
    (define-key map (kbd "C-c C-e") #'ipynb-cell-execute)
    (define-key map (kbd "C-c C-d") #'ipynb-inspect)
    (define-key map (kbd "C-c C-v") #'ipynb-inspect-cell)
    (define-key map (kbd "C-c C-p") #'ipynb-preview-markdown)
    (define-key map (kbd "C-c l s") #'ipynb-lsp-start)
    (define-key map (kbd "C-c l d") #'ipynb-lsp-definition)
    (define-key map (kbd "C-c l r") #'ipynb-lsp-references)
    (define-key map (kbd "C-c l n") #'ipynb-lsp-rename)
    (define-key map (kbd "C-c l h") #'ipynb-lsp-hover)
    (define-key map (kbd "C-c l f") #'ipynb-format-cell)
    map))
(define-minor-mode ipynb-cell-edit-mode
  "Edit an isolated notebook cell.  Commit with C-c C-c, cancel with C-c C-k."
  :lighter " Cell" :keymap ipynb-cell-edit-mode-map)
(defun ipynb-edit-cell () "Edit the current cell in its language's major mode." (interactive)
  (let* ((parent (current-buffer)) (cell (ipynb--current-cell))
         (existing (cl-find-if (lambda (b) (and (buffer-live-p b)
                                               (eq (buffer-local-value 'ipynb--cell b) cell))) ipynb--editors))
         (type (gethash "cell_type" cell)) (directory default-directory) (auto-inspect ipynb-auto-inspect)
         (mode (if (equal type "code") (cdr (assoc (ipynb--language) ipynb-language-modes))
                 (if (equal type "markdown") 'markdown-mode 'text-mode))))
    (if existing (pop-to-buffer existing)
      (let ((editor (generate-new-buffer (format "*%s cell %d*" (buffer-name) (1+ (ipynb--current-index))))))
        (push editor ipynb--editors)
        (pop-to-buffer editor)
        (setq default-directory directory)
        (insert (ipynb--text (gethash "source" cell)))
        (funcall (if (fboundp mode) mode 'text-mode))
        (setq-local ipynb-auto-inspect auto-inspect
                    ipynb--parent parent ipynb--cell cell
                    ipynb--original-source (buffer-string))
        (ipynb-cell-edit-mode 1)
        (add-hook 'completion-at-point-functions #'ipynb-completion-at-point nil t)
        (when ipynb-auto-inspect
          (add-hook 'eldoc-documentation-functions #'ipynb-eldoc-function nil t)
          (eldoc-mode 1))
        (add-hook 'write-contents-functions #'ipynb-cell-save nil t)
        (set-buffer-modified-p nil)
        (message "C-c C-c commit · C-c C-k cancel · C-c C-e run · C-c C-d inspect")))))
(defun ipynb-cell-save () "Sync this cell editor into its notebook." (interactive)
  (unless (buffer-live-p ipynb--parent) (user-error "Parent notebook was closed"))
  (let ((source (buffer-substring-no-properties (point-min) (point-max)))
        (cell ipynb--cell) (original ipynb--original-source))
    (with-current-buffer ipynb--parent
      (unless (memq cell ipynb--cells) (user-error "Cell no longer exists"))
      (unless (equal (ipynb--text (gethash "source" cell)) original)
        (user-error "Cell changed outside this editor; reopen it before editing"))
      (unless (equal source original)
        (ipynb--snapshot) (puthash "source" source cell) (ipynb--changed)))
    (setq ipynb--original-source source)
    (set-buffer-modified-p nil)) t)
(defun ipynb-cell-commit () "Sync cell edits and return to the notebook." (interactive)
  (ipynb-cell-save)
  (let ((parent ipynb--parent)) (kill-buffer (current-buffer)) (pop-to-buffer parent)))
(defun ipynb-cell-abort () "Discard changes since the last cell sync." (interactive)
  (let ((parent ipynb--parent)) (set-buffer-modified-p nil) (kill-buffer (current-buffer))
       (when (buffer-live-p parent) (pop-to-buffer parent))))
(defun ipynb-cell-execute () "Sync and execute the edited cell." (interactive)
  (ipynb-cell-save)
  (let ((cell ipynb--cell))
    (with-current-buffer ipynb--parent (ipynb--execute cell))))

(defun ipynb--sync-editors ()
  (dolist (editor ipynb--editors)
    (when (buffer-live-p editor) (with-current-buffer editor (ipynb-cell-save)))))
(defun ipynb--write ()
  (ipynb--sync-editors)
  (let ((data (ipynb--copy ipynb--notebook)) (file buffer-file-name)
        (coding-system-for-write 'utf-8-unix))
    (puthash "cells" (vconcat ipynb--cells) data)
    ;; Write through a temporary buffer: never write the rendered facade.
    (with-temp-buffer
      (insert (ipynb--json data)) (json-pretty-print-buffer) (insert "\n")
      (write-region (point-min) (point-max) file nil 'silent)))
  (set-visited-file-modtime) (set-buffer-modified-p nil) t)
(defun ipynb--revert (_ignore-auto _noconfirm)
  (ipynb--assert-no-editors)
  (ipynb-kernel-shutdown)
  (let* ((file buffer-file-name)
         (text (with-temp-buffer (insert-file-contents file) (buffer-string))))
    (ipynb--load text) (setq ipynb--history nil ipynb--future nil)
    (run-hooks 'ipynb-after-change-hook)
    (ipynb--render 0) (set-buffer-modified-p nil) (set-visited-file-modtime)))
(defun ipynb--load (text)
  (let* ((data (ipynb--parse text)) (cells (gethash "cells" data)))
    (unless (and (equal (gethash "nbformat" data) 4) (vectorp cells)
                 (hash-table-p (gethash "metadata" data)))
      (user-error "Expected a Jupyter nbformat 4 notebook"))
    (let ((ids (make-hash-table :test #'equal)))
      (mapc (lambda (cell)
              (unless (and (hash-table-p cell)
                           (member (gethash "cell_type" cell) '("code" "markdown" "raw"))
                           (let ((src (gethash "source" cell)))
                             (or (stringp src) (and (vectorp src) (cl-every #'stringp src)))))
                (user-error "Invalid notebook cell"))
              (let ((id (gethash "id" cell)))
                (when (or (not (stringp id)) (gethash id ids))
                  (setq id (ipynb--id)) (puthash "id" id cell))
                (puthash id t ids))) cells))
    (setq ipynb--notebook data ipynb--cells (append cells nil))))

;;;###autoload
(defun ipynb-create (file &optional kernel)
  "Create a new notebook at FILE using KERNEL." (interactive "FNotebook file: ")
  (when (file-exists-p file) (user-error "File already exists: %s" file))
  (let ((buffer (find-file-noselect file)))
    (pop-to-buffer buffer)
    (unless (derived-mode-p 'ipynb-mode) (ipynb-mode))
    (when kernel
      (puthash "kernelspec" (ipynb--object "name" kernel "display_name" kernel "language" "")
               (gethash "metadata" ipynb--notebook)))
    (set-buffer-modified-p t) (save-buffer)))

(defun ipynb--python ()
  (or ipynb-python-command
      (let ((root (locate-dominating-file default-directory
                      (lambda (dir) (cl-some (lambda (name) (file-executable-p (expand-file-name (concat name "/bin/python") dir)))
                                             '(".venv" "venv" ".virtualenv" "env"))))))
        (when root
          (cl-loop for name in '(".venv" "venv" ".virtualenv" "env")
                   for path = (expand-file-name (concat name "/bin/python") root)
                   when (file-executable-p path) return path)))
      (executable-find "python3") (user-error "Set ipynb-python-command to a Python executable")))
(defun ipynb--send (op &rest pairs)
  (unless (process-live-p ipynb--process) (user-error "Start a kernel first with K"))
  (let ((request (apply #'ipynb--object "op" op pairs)))
    (process-send-string ipynb--process (concat (ipynb--json request) "\n"))))
(defun ipynb--start (&optional python connection)
  (when (file-remote-p default-directory) (user-error "Remote notebooks: use a local copy"))
  (when (process-live-p ipynb--process) (user-error "A kernel is already connected"))
  (setq ipynb--status "starting" ipynb--requests (make-hash-table :test #'equal)
        ipynb--displays (make-hash-table :test #'equal) ipynb--pending-clear nil)
  (setq ipynb--process
        (make-process :name (generate-new-buffer-name "ipynb-kernel") :buffer nil
                      :command (append (list (or python (ipynb--python)) "-u"
                                             (expand-file-name "python/ipynb_bridge.py" ipynb--directory)
                                             "--kernel" (ipynb--kernel))
                                       (when connection (list "--connection" (expand-file-name connection))))
                      :connection-type 'pipe :coding 'utf-8-unix :noquery t
                      :stderr (get-buffer-create "*ipynb kernel log*")
                      :filter #'ipynb--filter :sentinel #'ipynb--sentinel))
  (process-put ipynb--process 'notebook (current-buffer))
  (force-mode-line-update))
(defun ipynb-kernel-start (&optional python)
  "Start the notebook's kernel; with prefix, choose bridge PYTHON." (interactive (list (when current-prefix-arg (read-file-name "Python: "))))
  (ipynb--start python))
(defun ipynb-kernel-connect (file) "Connect to the kernel in connection FILE." (interactive "fConnection file: ")
  (ipynb--start nil file))
(defun ipynb-kernel-interrupt () "Interrupt the owned kernel." (interactive) (ipynb--send "interrupt"))
(defun ipynb-kernel-restart () "Restart the owned kernel, losing its variables." (interactive)
  (ipynb--send "restart") (setq ipynb--status "restarting")
  (clrhash ipynb--requests) (clrhash ipynb--displays) (setq ipynb--pending-clear nil)
  (force-mode-line-update))
(defun ipynb-kernel-shutdown () "Shut down an owned kernel, or disconnect an external kernel." (interactive)
  (when (process-live-p ipynb--process)
    (ipynb--send "shutdown")
    ;; The bridge owns cleanup; don't kill it before it has stopped the kernel.
    (process-send-eof ipynb--process))
  (setq ipynb--status "disconnected") (force-mode-line-update))
(defun ipynb--sentinel (process _event)
  (let ((buffer (process-get process 'notebook)))
    (when (and (buffer-live-p buffer) (not (process-live-p process)))
      (with-current-buffer buffer
        (when (eq process ipynb--process)
          (setq ipynb--status "disconnected") (force-mode-line-update)
          (unless (zerop (process-exit-status process))
            (message "ipynb: bridge exited; see *ipynb kernel log*")))))))
(defun ipynb--filter (process chunk)
  (let* ((text (concat (process-get process 'partial) chunk))
         (lines (split-string text "\n")) (buffer (process-get process 'notebook)))
    (process-put process 'partial (car (last lines)))
    (when (buffer-live-p buffer)
      (with-current-buffer buffer
        (dolist (line (butlast lines))
          (unless (string-empty-p line)
            (condition-case err (ipynb--event (ipynb--parse line))
              (error (message "ipynb bridge: %s" (error-message-string err))))))))))
(defun ipynb--input (buffer process content)
  (when (and (buffer-live-p buffer) (process-live-p process))
    (with-current-buffer buffer
      (when (eq process ipynb--process)
        (condition-case nil
            (ipynb--send "input" "value"
                         (if (eq (gethash "password" content) t)
                             (read-passwd (gethash "prompt" content))
                           (read-string (gethash "prompt" content))))
          (quit (ipynb-kernel-interrupt)))))))
(defun ipynb--event (event)
  (let* ((kind (gethash "event" event)) (type (gethash "type" event))
         (content (gethash "content" event))
         (id (gethash "id" event))
         (cell (and ipynb--requests (gethash id ipynb--requests))))
    (cond
     ((equal kind "finished") (remhash id ipynb--requests))
     ((equal kind "ready") (setq ipynb--status "idle") (force-mode-line-update))
     ((equal kind "error") (message "ipynb: %s" (gethash "message" event)))
     ((equal type "status")
      (setq ipynb--status (gethash "execution_state" content)) (force-mode-line-update))
     ((equal type "input_request") (when cell (run-at-time 0 nil #'ipynb--input (current-buffer) ipynb--process content)))
     ((member type '("inspect_reply" "complete_reply"))
      (when (functionp cell) (funcall cell content) (remhash id ipynb--requests)))
     ((equal type "update_display_data")
      (let* ((display-id (gethash "display_id" (gethash "transient" content (ipynb--object))))
             (targets (gethash display-id ipynb--displays)))
        (dolist (output targets)
          (puthash "data" (gethash "data" content) output)
          (puthash "metadata" (gethash "metadata" content) output))
        (when targets (ipynb--changed))))
     ((and (hash-table-p cell) (memq cell ipynb--cells) (equal (gethash "cell_type" cell) "code"))
      (cond
       ((equal type "execute_input")
        (puthash "execution_count" (gethash "execution_count" content) cell)
        (setq ipynb--pending-clear (delq cell ipynb--pending-clear))
        (puthash "outputs" [] cell) (ipynb--changed))
       ((equal type "clear_output")
        (if (eq (gethash "wait" content) t) (cl-pushnew cell ipynb--pending-clear)
          (setq ipynb--pending-clear (delq cell ipynb--pending-clear))
          (puthash "outputs" [] cell) (ipynb--changed)))
       ((member type '("stream" "display_data" "execute_result" "error"))
        (when (memq cell ipynb--pending-clear)
          (puthash "outputs" [] cell) (setq ipynb--pending-clear (delq cell ipynb--pending-clear)))
        (let ((output (ipynb--copy content))
              (display-id (gethash "display_id" (gethash "transient" content (ipynb--object)))))
          (puthash "output_type" type output) (remhash "transient" output)
          (puthash "outputs" (vconcat (gethash "outputs" cell) (vector output)) cell)
          (when display-id (push output (gethash display-id ipynb--displays))))
        (ipynb--changed)))))))
(defun ipynb--execute (cell)
  (unless (equal (gethash "cell_type" cell) "code") (user-error "Only code cells execute"))
  (unless (member ipynb--status '("idle" "busy")) (user-error "Kernel is not ready; start it with K"))
  (let ((id (ipynb--id)))
    (puthash id cell ipynb--requests)
    (ipynb--send "execute" "id" id "cell" (gethash "id" cell) "code" (ipynb--text (gethash "source" cell)))))
(defun ipynb-execute-cell () "Execute the current code cell." (interactive)
  (ipynb--sync-editors) (ipynb--execute (ipynb--current-cell)))
(defun ipynb-execute-and-next () "Execute a code cell and move to the next cell." (interactive)
  (when (equal (gethash "cell_type" (ipynb--current-cell)) "code") (ipynb-execute-cell))
  (if (= (ipynb--current-index) (1- (length ipynb--cells))) (ipynb-insert-cell) (ipynb-next-cell)))
(defun ipynb-execute-all (&optional below) "Execute all code cells, or current and BELOW." (interactive "P")
  (ipynb--sync-editors)
  (dolist (cell (if below (nthcdr (ipynb--current-index) ipynb--cells) ipynb--cells))
    (when (equal (gethash "cell_type" cell) "code") (ipynb--execute cell))))
(defun ipynb-clear-output (&optional all) "Clear the current cell's output, or ALL outputs." (interactive "P")
  (ipynb--snapshot)
  (dolist (cell (if all ipynb--cells (list (ipynb--current-cell))))
    (when (equal (gethash "cell_type" cell) "code")
      (puthash "outputs" [] cell) (puthash "execution_count" :null cell)))
  (ipynb--changed))
(defun ipynb-show-output () "Show current outputs in a separate, copyable buffer." (interactive)
  (let ((outputs (gethash "outputs" (ipynb--current-cell))))
    (with-current-buffer (get-buffer-create "*ipynb output*")
      (let ((inhibit-read-only t)) (erase-buffer) (mapc #'ipynb--insert-output outputs))
      (special-mode) (goto-char (point-min)) (display-buffer (current-buffer)))))
(defun ipynb-inspect () "Inspect the symbol at point in a cell, or an expression in notebook view." (interactive)
  (let* ((editor ipynb-cell-edit-mode)
         (code (if editor (buffer-substring-no-properties (point-min) (point-max)) (read-string "Inspect: ")))
         (cursor (if editor (1- (point)) (length code)))
         (parent (if editor ipynb--parent (current-buffer))))
    (with-current-buffer parent
      (let ((id (ipynb--id)))
        (unless ipynb--requests (user-error "Start a kernel first"))
        (puthash id (lambda (content)
                      (with-current-buffer (get-buffer-create "*ipynb inspect*")
                        (let ((inhibit-read-only t))
                          (erase-buffer)
                          (insert (ansi-color-apply (ipynb--text
                                    (gethash "text/plain" (gethash "data" content (ipynb--object)) "No information available")))))
                        (special-mode) (goto-char (point-min)) (display-buffer (current-buffer)))) ipynb--requests)
        (ipynb--send "inspect" "id" id "code" code "cursor" cursor)))))
(defun ipynb-completion-at-point () "Request completion from the live kernel in a cell editor."
  (when (and ipynb-cell-edit-mode (buffer-live-p ipynb--parent))
    (let ((code (buffer-substring-no-properties (point-min) (point-max)))
          (cursor (1- (point))) reply done)
      (with-current-buffer ipynb--parent
        (when (and (process-live-p ipynb--process) (equal ipynb--status "idle"))
          (let ((id (ipynb--id)) (deadline (+ (float-time) 1.0)))
            (puthash id (lambda (content) (setq reply content done t)) ipynb--requests)
            (ipynb--send "complete" "id" id "code" code "cursor" cursor)
            (while (and (not done) (< (float-time) deadline)) (accept-process-output ipynb--process 0.05))
            (remhash id ipynb--requests))))
      (when (and reply (equal (gethash "status" reply) "ok"))
        (list (1+ (gethash "cursor_start" reply)) (1+ (gethash "cursor_end" reply))
              (append (gethash "matches" reply) nil) :exclusive 'no)))))
(defun ipynb-toggle-auto-hover ()
  "Toggle automatic Jupyter inspection in this notebook's cell editors." (interactive)
  (let ((parent (if ipynb-cell-edit-mode ipynb--parent (current-buffer))))
    (with-current-buffer parent
      (setq-local ipynb-auto-inspect (not ipynb-auto-inspect))
      (let ((enabled ipynb-auto-inspect))
        (dolist (editor ipynb--editors)
          (when (buffer-live-p editor)
            (with-current-buffer editor
              (setq-local ipynb-auto-inspect enabled)
              (if enabled
                  (progn (add-hook 'eldoc-documentation-functions #'ipynb-eldoc-function nil t) (eldoc-mode 1))
                (remove-hook 'eldoc-documentation-functions #'ipynb-eldoc-function t)))))
        (message "Jupyter auto-hover %s" (if enabled "enabled" "disabled"))))))

(defun ipynb-eldoc-function (callback &rest _ignored)
  "Supply live kernel inspection to Eldoc CALLBACK."
  (when (and ipynb-cell-edit-mode (buffer-live-p ipynb--parent))
    (let ((code (buffer-substring-no-properties (point-min) (point-max)))
          (cursor (1- (point))))
      (with-current-buffer ipynb--parent
        (when (and (process-live-p ipynb--process) (equal ipynb--status "idle"))
          (let ((id (ipynb--id)))
            (puthash id (lambda (content)
                          (when (eq (gethash "found" content) t)
                            (funcall callback (ansi-color-apply
                                               (ipynb--text (gethash "text/plain" (gethash "data" content)))))))
                     ipynb--requests)
            (ipynb--send "inspect" "id" id "code" code "cursor" cursor))
          t)))))

(defun ipynb-list-kernels () "Display installed kernels for the selected bridge Python." (interactive)
  (let ((python (ipynb--python)))
    (with-current-buffer (get-buffer-create "*ipynb kernels*")
      (let ((inhibit-read-only t))
        (erase-buffer)
        (call-process python nil t nil (expand-file-name "python/ipynb_bridge.py" ipynb--directory) "--list"))
      (special-mode) (display-buffer (current-buffer)))))
(defun ipynb-set-kernel (name language)
  "Set kernelspec NAME and LANGUAGE for this notebook." (interactive "sKernelspec name (e.g. python3, ir): \nsLanguage (e.g. python, R): ")
  (when (process-live-p ipynb--process) (user-error "Shut down the current kernel first"))
  (when (fboundp 'ipynb-lsp-stop) (ipynb-lsp-stop))
  (puthash "kernelspec" (ipynb--object "name" name "display_name" name "language" language)
           (gethash "metadata" ipynb--notebook))
  (puthash "language_info" (ipynb--object "name" language) (gethash "metadata" ipynb--notebook))
  (ipynb--changed))

(autoload 'ipynb-inspect-cell "ipynb-inspector" nil t)
(autoload 'ipynb-preview-markdown "ipynb-preview" nil t)
(autoload 'ipynb-toggle-markdown-preview "ipynb-preview" nil t)
(autoload 'ipynb-lsp-start "ipynb-lsp" nil t)
(autoload 'ipynb-lsp-stop "ipynb-lsp" nil t)
(autoload 'ipynb-lsp-definition "ipynb-lsp" nil t)
(autoload 'ipynb-lsp-references "ipynb-lsp" nil t)
(autoload 'ipynb-lsp-rename "ipynb-lsp" nil t)
(autoload 'ipynb-lsp-hover "ipynb-lsp" nil t)
(autoload 'ipynb-format-cell "ipynb-lsp" nil t)

(defvar ipynb-mode-map
  (let ((map (make-sparse-keymap)))
    (dolist (binding '(("n" . ipynb-next-cell) ("p" . ipynb-previous-cell)
                       ("j" . ipynb-jump-to-cell) ("RET" . ipynb-edit-cell)
                       ("b" . ipynb-insert-cell) ("a" . ipynb-insert-cell-above)
                       ("d" . ipynb-cut-cell) ("w" . ipynb-copy-cell) ("y" . ipynb-paste-cell)
                       ("M-<up>" . ipynb-move-cell-up) ("M-<down>" . ipynb-move-cell-down)
                       ("t" . ipynb-set-cell-type) ("TAB" . ipynb-toggle-fold)
                       ("u" . ipynb-undo) ("C-r" . ipynb-redo)
                       ("C-<return>" . ipynb-execute-cell) ("S-<return>" . ipynb-execute-and-next)
                       ("C-c C-c" . ipynb-execute-cell) ("C-c C-a" . ipynb-execute-all)
                       ("o" . ipynb-show-output) ("c" . ipynb-clear-output)
                       ("K" . ipynb-kernel-start) ("I" . ipynb-kernel-interrupt)
                       ("R" . ipynb-kernel-restart) ("Q" . ipynb-kernel-shutdown)
                       ("h" . ipynb-inspect) ("H" . ipynb-toggle-auto-hover) ("v" . ipynb-inspect-cell)
                       ("P" . ipynb-toggle-markdown-preview) ("C-c C-p" . ipynb-preview-markdown) ("L" . ipynb-lsp-start)
                       ("C-c l d" . ipynb-lsp-definition) ("C-c l r" . ipynb-lsp-references)
                       ("C-c l n" . ipynb-lsp-rename) ("C-c l h" . ipynb-lsp-hover)
                       ("C-c l f" . ipynb-format-cell)))
      (define-key map (kbd (car binding)) (cdr binding))) map))

;;;###autoload
(define-derived-mode ipynb-mode special-mode "Notebook"
  "Major mode for Jupyter notebooks, with isolated cell editors.
\{ipynb-mode-map}"
  (let ((text (buffer-substring-no-properties (point-min) (point-max))))
    (if (string-empty-p (string-trim text))
        (setq ipynb--notebook
              (ipynb--object "nbformat" 4 "nbformat_minor" 5 "cells" []
                             "metadata" (ipynb--object "kernelspec"
                                          (ipynb--object "name" ipynb-default-kernel
                                                         "display_name" ipynb-default-kernel "language" "python")))
              ipynb--cells (list (ipynb--new-cell)))
      (condition-case err (ipynb--load text)
        (error (fundamental-mode) (setq buffer-read-only nil)
               (signal (car err) (cdr err)))))
    (setq-local write-contents-functions '(ipynb--write)
                revert-buffer-function #'ipynb--revert
                buffer-auto-save-file-name nil
                mode-line-process '(:eval (concat " [" ipynb--status "]")))
    (auto-save-mode -1)
    (add-hook 'kill-buffer-hook #'ipynb-kernel-shutdown nil t)
    (add-hook 'window-size-change-functions #'ipynb--window-resized nil t)
    (ipynb--render 0) (set-buffer-modified-p nil)))

;;;###autoload
(add-to-list 'auto-mode-alist '("\\.ipynb\\'" . ipynb-mode))
(provide 'ipynb)
