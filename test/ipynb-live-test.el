;;; ipynb-live-test.el --- End-to-end Emacs/kernel test -*- lexical-binding: t; -*-
(require 'ert)
(require 'ipynb)
(require 'ipynb-inspector)

(defun ipynb-test-wait (predicate)
  (let ((deadline (+ (float-time) 30)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (should (funcall predicate))))

(ert-deftest ipynb-live-execute-and-save ()
  (let* ((ipynb-python-command (or (getenv "IPYNB_TEST_PYTHON") "python3"))
         (directory (make-temp-file "ipynb-live-" t))
         (file (expand-file-name "test.ipynb" directory))
         (process-environment (copy-sequence process-environment))
         (buffer (generate-new-buffer " *ipynb-live*")) process panel)
    (setenv "JUPYTER_RUNTIME_DIR" directory)
    (setenv "IPYTHONDIR" directory)
    (unwind-protect
        (with-current-buffer buffer
          (setq buffer-file-name file default-directory (file-name-as-directory directory))
          (ipynb-mode)
          (puthash "source" "print('世界')\n21 * 2" (car ipynb--cells))
          (ipynb-kernel-start)
          (setq process ipynb--process)
          (ipynb-test-wait (lambda () (equal ipynb--status "idle")))
          (ipynb-execute-cell)
          (ipynb-test-wait (lambda () (zerop (hash-table-count ipynb--requests))))
          (let ((outputs (gethash "outputs" (car ipynb--cells))))
            (should (= 2 (length outputs)))
            (should (equal "世界\n" (gethash "text" (aref outputs 0)))))
          (save-buffer)
          (should-not (buffer-modified-p))
          (let ((data (with-temp-buffer (insert-file-contents file) (ipynb--parse (buffer-string)))))
            (should (= 2 (length (gethash "outputs" (aref (gethash "cells" data) 0))))))
          (should (zerop (call-process ipynb-python-command nil nil nil "-c"
                            "import nbformat,sys; nbformat.validate(nbformat.read(sys.argv[1],as_version=4))" file)))
          (puthash "source" "answer = 42" (car ipynb--cells))
          (ipynb-execute-cell)
          (ipynb-test-wait (lambda () (zerop (hash-table-count ipynb--requests))))
          (save-window-excursion
            (ipynb-inspect-cell)
            (setq panel (current-buffer)))
          (with-current-buffer panel
            (ipynb-test-wait (lambda () (string-match-p "objects" (or mode-line-process ""))))
            (should (equal "int" (aref (cadr (assoc "answer" tabulated-list-entries)) 1)))
            (should (equal "42" (aref (cadr (assoc "answer" tabulated-list-entries)) 2))))
          (ipynb-kernel-shutdown)
          (ipynb-test-wait (lambda () (not (process-live-p process)))))
      (when (buffer-live-p panel) (kill-buffer panel))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (ipynb-kernel-shutdown) (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (when (process-live-p process)
        (let ((deadline (+ (float-time) 10)))
          (while (and (process-live-p process) (< (float-time) deadline))
            (accept-process-output process 0.1))))
      (delete-directory directory t))))
