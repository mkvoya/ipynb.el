;;; ipynb-preview-test.el --- Preview and inspector tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'ipynb-preview)
(require 'ipynb-inspector)
(ert-deftest ipynb-inspector-tokenization ()
  (should (equal '("answer" "obj.value" "print")
                 (ipynb-inspector--symbols "answer = obj.value # hidden\nprint('not_a_name', answer)" 'python-mode))))
(ert-deftest ipynb-inspector-summary ()
  (should (equal ["int" "42"] (ipynb-inspector--summary "Type: int\nString form: 42\nDocstring: ..."))))
(ert-deftest ipynb-markdown-preserves-source-and-caches ()
  (with-temp-buffer
    (ipynb-mode)
    (puthash "cell_type" "markdown" (car ipynb--cells))
    (puthash "source" "# heading" (car ipynb--cells))
    (let ((calls 0))
      (cl-letf (((symbol-function 'ipynb-preview--render) (lambda (&rest _) (cl-incf calls) "heading\n")))
        (ipynb--render) (ipynb--render)
        (should (= 1 calls))
        (should (equal "# heading" (gethash "source" (car ipynb--cells))))
        (should-not (string-match-p "# heading" (buffer-string)))
        (ipynb-toggle-markdown-preview)
        (should (string-match-p "# heading" (buffer-string)))))))
(ert-deftest ipynb-markdown-failure-falls-back-to-source ()
  (with-temp-buffer
    (ipynb-mode)
    (puthash "cell_type" "markdown" (car ipynb--cells))
    (puthash "source" "# heading" (car ipynb--cells))
    (cl-letf (((symbol-function 'ipynb-preview--render) (lambda (&rest _) (error "missing renderer"))))
      (ipynb--render)
      (should (string-match-p "# heading" (buffer-string)))
      (should (equal "missing renderer" ipynb-preview--error)))))
(ert-deftest ipynb-markdown-inline-images-never-fetch ()
  (with-temp-buffer
    (ipynb-preview--image '(img ((src . "https://example.com/tracker.png") (alt . "remote"))))
    (should (equal "[Image: remote]" (buffer-string)))))
(ert-deftest ipynb-markdown-real-renderer ()
  (skip-unless (getenv "IPYNB_TEST_PYTHON"))
  (let* ((ipynb-python-command (getenv "IPYNB_TEST_PYTHON"))
         (text (ipynb-preview--render "# Heading\n\n**Bold** and [link](https://example.com)\n\n| a | b |\n|---|---|\n| 1 | 2 |\n\n```python\nx = 1\n```\n<script>alert(1)</script>\n![remote](https://example.com/image.png)" nil 80)))
    (should (string-prefix-p "Heading" text))
    (should (string-match-p "Bold and link" text))
    (should (string-match-p "x = 1" text))
    (should (string-match-p "<script>" text))
    (should (string-match-p "Image: remote" text))
    (should (equal "https://example.com" (get-text-property (string-match "link" text) 'shr-url text)))))
